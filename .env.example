# ══════════════════════════════════════════════════════════════════
# Окружение для KiloImportService — dev/тест-стенд
# Скопировать в `.env` и заполнить значения для своей среды:
#     cp .env.example .env
# ══════════════════════════════════════════════════════════════════
#
# Для preprod/prod используются отдельные шаблоны:
#     cp .env.preprod.example .env     # → перевести стенд на pre-isup
#     cp .env.prod.example    .env     # → перевести стенд на prod
# См. doc_project/122-environment-config.md.
#
# ⚠️ Все переменные **без default-fallback** в docker-compose: без
#    значения `docker compose up` остановится с понятным сообщением.
#    Это сознательная «deny-by-default» политика — секреты/хосты
#    никогда не утекают в код или git (см. doc_project/121).

# ══════════════════════════════════════════════════════════════════
# 1. Хосты внешних систем (Visary)
# ══════════════════════════════════════════════════════════════════
# Единая SSOT-переменная для API Visary. Используется и backend'ом
# (через `Visary__BaseUrl`), и frontend-Vite-proxy (через `VITE_VISARY_API_URL`).
# Маппинг см. docker-compose.yml.
#
#   dev/test :    https://isup-alfa-test.k8s.npc.ba
#   preprod  :    https://pre-isup-alfa.k8s.npc.ba
#   prod     :    https://isup-alfa.k8s.npc.ba
VISARY_BASE_URL=https://isup-alfa-test.k8s.npc.ba

# IdP Visary (OIDC token endpoint). Если пусто — backend пытается
# вывести как `https://id-<host>/connect/token`, где `<host>` это
# то, что после `https://` в `VISARY_BASE_URL` (см. Program.cs).
# Заполнить явно, если IdP-хост не следует этой схеме (редко).
#   test  : https://id-isup-alfa-test.k8s.npc.ba
#   prod  : https://id-isup-alfa.k8s.npc.ba
VISARY_AUTH_BASE_URL=

# ══════════════════════════════════════════════════════════════════
# 2. Хост UI (для CORS-allowlist backend'а)
# ══════════════════════════════════════════════════════════════════
# Один origin, по которому пользователи открывают UI. В dev это Vite
# dev-server; в prod — реальный публичный URL.
#   dev     : http://localhost:5173
#   preprod : https://pre-import.alfa.test
#   prod    : https://import.alfa.bank
UI_PUBLIC_URL=http://localhost:5173

# ══════════════════════════════════════════════════════════════════
# 3. Креды локального PostgreSQL (для dev в docker-compose)
# ══════════════════════════════════════════════════════════════════
# Используются и postgres-контейнерами (POSTGRES_USER/PASSWORD), и
# backend'ом для строки подключения. В разных средах — разные пароли.
#
# Для **prod/preprod** с внешней (managed) БД эти переменные не
# используются — задавай ConnectionStrings_*_CONNECTION_STRING целиком
# (см. ниже секцию 5).

# service-db (служебная БД сервиса под управлением EF Core)
IMPORT_SERVICE_DB_USER=import_service
IMPORT_SERVICE_DB_PASSWORD=change_me_locally

# visary-срез (целевая БД, DB-first)
VISARY_DB_USER=visary
VISARY_DB_PASSWORD=change_me_locally

# ══════════════════════════════════════════════════════════════════
# 4. Bearer-токены и OIDC refresh
# ══════════════════════════════════════════════════════════════════
# Bearer для прямых запросов из frontend (dev/легаси-режим).
# На prod заменяется backend'овым OIDC refresh-flow (см. ниже).
# НИКОГДА не коммитить.
VITE_VISARY_API_TOKEN=

# Backend Bearer (легаси-fallback, если OIDC не настроен).
Visary__BearerToken=

# OIDC refresh_token flow (см. doc_project/107-visary-token-provider.md).
# Если `Visary__Auth__TokenEndpoint` пуст — backend использует static-token
# из `Visary__BearerToken`. Для prod заполнить:
Visary__Auth__TokenEndpoint=
Visary__Auth__ClientId=visary-ui
# Капчурится один раз: залогиниться в Visary UI с offline_access scope,
# выдернуть refresh_token из ответа /oidc/connect/token и положить сюда.
# На prod заменить EnvironmentRefreshTokenStore на VaultRefreshTokenStore
# в Program.cs (хранить токен в Vault, НЕ в .env).
VISARY_AUTH_REFRESH_TOKEN=

# ══════════════════════════════════════════════════════════════════
# 5. Аутентификация ВХОДЯЩИХ запросов (опционально, см. doc 111)
# ══════════════════════════════════════════════════════════════════
# JwtBearer-валидация запросов к нашему backend через тот же Visary IdP.
# Authority пуст = auth ОТКЛЮЧЕНА (легаси/dev). На prod заполнить.
Auth__Authority=
Auth__Audience=kilo-import-api
Auth__RequireHttpsMetadata=true

# ══════════════════════════════════════════════════════════════════
# 6. Внешняя БД (override для prod/preprod с managed PostgreSQL)
# ══════════════════════════════════════════════════════════════════
# Если БД не в docker-compose, а managed (например, RDS/Azure), задай
# полные connection strings — они перекрывают всё, что строится из частей
# в docker-compose. В dev можно оставить пустыми (тогда docker-compose
# построит строки сам из IMPORT_SERVICE_DB_*/VISARY_DB_* выше).
#
# ConnectionStrings__ServiceDb=Host=managed-pg.alfa.bank;Port=5432;Database=import_service_db;Username=...;Password=...
# ConnectionStrings__VisaryDb=Host=managed-pg.alfa.bank;Port=5432;Database=visary_webapi_db;Username=...;Password=...
