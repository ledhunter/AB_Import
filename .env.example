# ══════════════════════════════════════════════════════════════════
# Окружение для docker-compose (скопировать в .env при необходимости)
# ══════════════════════════════════════════════════════════════════

# URL внешней Visary-системы (для загрузки списка проектов в UI).
# Если пусто — frontend работает только с локальным backend без Visary.
VITE_VISARY_API_URL=https://isup-alfa-test.k8s.npc.ba

# Bearer-токен для Visary API (UI и backend читают одну и ту же переменную через .env / docker-compose).
# Никогда не коммитить!
VITE_VISARY_API_TOKEN=

# ── Backend (KiloImportService.Api) ──────────────────────────────────
# Можно задать через env или прямо в appsettings.Development.json (секция "Visary").
# Пример (PowerShell): $env:Visary__BearerToken = "<jwt>"
Visary__BaseUrl=https://isup-alfa-test.k8s.npc.ba
Visary__BearerToken=

# ── OIDC refresh_token flow (см. doc_project/107-visary-token-provider.md) ──
# Если Visary__Auth__TokenEndpoint пуст — backend использует static-token из Visary__BearerToken
# (легаси-режим). Заполнить ВСЕ три ниже, чтобы включить автоматический refresh.
Visary__Auth__TokenEndpoint=
Visary__Auth__ClientId=visary-ui
# Refresh-token капчурится один раз: залогиниться в Visary UI с offline_access scope,
# выдернуть refresh_token из ответа /oidc/connect/token (DevTools → Network → токен-запрос),
# положить в этот env. На prod — заменить EnvironmentRefreshTokenStore на VaultRefreshTokenStore
# в Program.cs и хранить токен в Vault (НЕ в .env).
VISARY_AUTH_REFRESH_TOKEN=

# ── Аутентификация ВХОДЯЩИХ запросов в наш backend (см. doc_project/111-incoming-jwt-auth.md) ──
# JWT bearer-валидация через тот же Visary IdP. Authority пуст = auth ОТКЛЮЧЕНА (legacy/dev).
# На prod — заполнить Authority и Audience, согласовать значения с админом IdP.
Auth__Authority=
Auth__Audience=kilo-import-api
Auth__RequireHttpsMetadata=true
