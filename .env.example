# ══════════════════════════════════════════════════════════════════
# Окружение для KiloImportService — dev/test-стенд
# Скопировать в `.env` и заполнить значения для своей среды:
#     cp .env.example .env
# ══════════════════════════════════════════════════════════════════
#
# Для preprod/prod используются отдельные шаблоны:
#     cp .env.preprod.example .env     # → перевести стенд на pre-isup
#     cp .env.prod.example    .env     # → перевести стенд на prod
# См. doc 122-environment-config + doc 145-helm-values-and-config-alignment.
#
# ⚠️ Имена секций конфига приведены к эталону service-dev (см. doc 132 / doc 145):
#    EndpointsConfiguration:VisaryApi/VisaryAuthApi, JwtConfiguration,
#    Features:Swagger/RequireJwt, Cors (строка), ConnectionStrings:AbFmImport.
#    В env маппится двойным подчёркиванием.
#
# ⚠️ Все переменные **без default-fallback** в docker-compose: без
#    значения `docker compose up` останавливается с понятным сообщением.
#    Это сознательная «deny-by-default» политика — секреты/хосты
#    никогда не утекают в код или git (см. doc 121).

# ══════════════════════════════════════════════════════════════════
# 1. Хосты внешних систем (Visary)
# ══════════════════════════════════════════════════════════════════
# Единая SSOT-переменная для API Visary. Используется и backend'ом
# (через `EndpointsConfiguration__VisaryApi__Endpoint`), и frontend-Vite-proxy
# (через `VITE_VISARY_API_URL`). Маппинг см. docker-compose.yml.
#
#   dev/test :    https://isup-alfa-test.k8s.npc.ba
#   preprod  :    https://pre-isup-alfa.k8s.npc.ba
#   prod     :    https://isup-alfa.k8s.npc.ba
VISARY_BASE_URL=https://isup-alfa-test.k8s.npc.ba

# IdP Visary (OIDC token endpoint). Опц., если IdP-хост не следует схеме
# `id-<api-host>`. См. doc 107.
VISARY_AUTH_BASE_URL=

# ══════════════════════════════════════════════════════════════════
# 2. Хост UI (для CORS-allowlist backend'а)
# ══════════════════════════════════════════════════════════════════
# Один origin, по которому пользователи открывают UI. В dev это Vite
# dev-server; в prod — реальный публичный URL. Маппится на `Cors` в
# конфиге backend (одна строка, эталон).
#   dev     : http://localhost:5173
#   preprod : https://pre-import.alfa.test
#   prod    : https://import.alfa.bank
UI_PUBLIC_URL=http://localhost:5173

# ══════════════════════════════════════════════════════════════════
# 3. Креды локального PostgreSQL (одна БД, см. doc 145 — B1)
# ══════════════════════════════════════════════════════════════════
# Имена переменных совпадают с тем, что платформа Альфы инжектит в k8s-под:
# ABFMI_DB_USER / ABFMI_DB_USER_PASSWORD (см. alfa-building-fm-import.yaml).
# В docker-compose эти креды получает локальный postgres-контейнер И backend
# (строит ConnectionStrings__AbFmImport из частей, если она не задана целиком).
#
# Для **prod/preprod** с managed-БД эти переменные обычно не нужны —
# `ConnectionStrings__AbFmImport` задаётся целиком из Vault.

ABFMI_DB_USER=ab_fm_import_user
ABFMI_DB_USER_PASSWORD=change_me_locally

# ══════════════════════════════════════════════════════════════════
# 4. Bearer-токены и OIDC refresh
# ══════════════════════════════════════════════════════════════════
# Bearer для прямых запросов из frontend (dev/легаси-режим).
# На prod заменяется backend'овым OIDC refresh-flow.
# НИКОГДА не коммитить.
VITE_VISARY_API_TOKEN=

# Backend Bearer (легаси-fallback, если OIDC не настроен).
EndpointsConfiguration__VisaryApi__BearerToken=

# OIDC refresh_token flow (см. doc 107).
# Если `EndpointsConfiguration__VisaryAuthApi__TokenEndpoint` пуст —
# backend использует static-token из BearerToken выше. Для prod заполнить:
EndpointsConfiguration__VisaryAuthApi__TokenEndpoint=
EndpointsConfiguration__VisaryAuthApi__ClientId=visary-ui
# Капчурится один раз: залогиниться в Visary UI с offline_access scope,
# выдернуть refresh_token из ответа /oidc/connect/token и положить сюда.
# На prod заменить EnvironmentRefreshTokenStore на VaultRefreshTokenStore
# в Program.cs (хранить токен в Vault, НЕ в .env).
VISARY_AUTH_REFRESH_TOKEN=

# ══════════════════════════════════════════════════════════════════
# 5. JWT-валидация входящих запросов (опционально, см. doc 111)
# ══════════════════════════════════════════════════════════════════
# `Features:RequireJwt=true` И `JwtConfiguration:Authority` непуст —
# backend требует валидный JWT на всех контроллерах/хабах. На prod включить.
# Features__Swagger=true — открыть /swagger (по эталону всё OFF в проде).
Features__Swagger=false
Features__RequireJwt=false
JwtConfiguration__Authority=
JwtConfiguration__Audience=kilo-import-api
# `UseSsl=true` (эталонное имя) — требовать HTTPS у IdP metadata-endpoint'а.
JwtConfiguration__UseSsl=true

# ══════════════════════════════════════════════════════════════════
# 5a. Reverse-proxy base-path (см. doc 147)
# ══════════════════════════════════════════════════════════════════
# Когда сервис публикуется за nginx/ingress под URL-префиксом —
# например, `https://abdev.moscow.alfaintra.net/api/ab-fm-import/…` для API
# и `https://…/api/ab-fm-import-web/…` для UI — нужно сообщить:
#  • backend'у — какой PathBase «отрезать» (`UsePathBase`)
#  • Vite-сборке — какой URL-префикс класть в ассеты (`base`)
#  • фронтенд-клиенту — какой префикс добавлять к /api/* и /hubs/*
#
# Пусто (по дефолту) = «локалка», маршруты обслуживаются от корня '/'.
#
#   dev/local : (всё пусто)
#   стенд    : Features__PathBase=/api/ab-fm-import
#              VITE_BASE_URL=/api/ab-fm-import-web/    (для SPA-ассетов; trailing /)
#              VITE_API_PREFIX=/api/ab-fm-import        (для apiUrl.ts; БЕЗ trailing /)
#
# ⚠️ Если UI и API под ОДНИМ префиксом — VITE_BASE_URL и VITE_API_PREFIX равны
#    (только trailing `/` у VITE_BASE_URL).
Features__PathBase=
VITE_BASE_URL=/
VITE_API_PREFIX=

# ══════════════════════════════════════════════════════════════════
# 6. Внешняя БД (override для prod/preprod с managed PostgreSQL)
# ══════════════════════════════════════════════════════════════════
# В prod-сценарии задаётся целиком из Vault — перекрывает построенную
# в docker-compose из частей выше. В dev можно оставить пустой.
#
# ConnectionStrings__AbFmImport=Host=managed-pg.alfa.bank;Port=5432;Database=ab_fm_import;Username=...;Password=...

# ══════════════════════════════════════════════════════════════════
# 7. Build-time: переопределение источников образов и пакетов
# ══════════════════════════════════════════════════════════════════
# См. doc 129 (build-args) и doc 132 (адаптация под эталон).
# DOTNET_SDK_IMAGE=docker-hub.binary.alfabank.ru/dotnet/sdk:10.0-alpine
# DOTNET_ASPNET_IMAGE=docker-hub.binary.alfabank.ru/dotnet/aspnet:10.0-alpine
# NODE_IMAGE=docker-hub.binary.alfabank.ru/library/node:20-alpine
# NGINX_IMAGE=docker-hub.binary.alfabank.ru/library/nginx:1.29-alpine
# POSTGRES_IMAGE=docker-hub.binary.alfabank.ru/library/postgres:16-alpine
# NUGET_FEED_URL=https://nuget.corp.alfa/repository/nuget-proxy/index.json
# NPM_REGISTRY_URL=https://binary.alfabank.ru/artifactory/api/npm/npm/
# NPM_REGISTRY_ALFALAB_URL=https://binary.alfabank.ru/artifactory/api/npm/npm/
# ALPINE_MIRROR=alpine.mirror.corp.alfa
# ALPINE_REPOSITORIES_URL=https://binary.alfabank.ru/artifactory/alpine-mirror/latest-stable
# ALPINE_OPENSSL_EDGE_FALLBACK=false
# ALPINE_EDGE_REPO_URL=https://dl-cdn.alpinelinux.org/alpine/edge/main
