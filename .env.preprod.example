# ══════════════════════════════════════════════════════════════════
# Окружение для KiloImportService — PREPROD
# Скопировать в `.env` (НЕ коммитить):
#     cp .env.preprod.example .env
# ══════════════════════════════════════════════════════════════════
# Это шаблон. Реальные значения паролей/токенов выдаёт админ среды.
# См. doc_project/122-environment-config.md.

# ── 1. Хосты внешних систем ──────────────────────────────────────
VISARY_BASE_URL=https://pre-isup-alfa.k8s.npc.ba
# Если IdP-хост следует схеме `id-<api-host>` — можно оставить пустым.
VISARY_AUTH_BASE_URL=

# ── 2. Хост UI (CORS-allowlist) ──────────────────────────────────
UI_PUBLIC_URL=https://pre-import.alfa.test

# ── 3. БД ─────────────────────────────────────────────────────────
# Preprod использует managed-PostgreSQL — задаём connection strings целиком.
# Креды получает админ среды. Username/Password оставлены пустыми сознательно:
# placeholder'ы вида `__FILL__` ловятся сканером как «секрет» (см. doc 121
# § AppSec v3). Перед запуском подставить значения из Vault.
ConnectionStrings__ServiceDb=Host=preprod-pg.alfa.test;Port=5432;Database=import_service_db;Username=;Password=
ConnectionStrings__VisaryDb=Host=preprod-pg.alfa.test;Port=5432;Database=visary_webapi_db;Username=;Password=
# Не используются на preprod (managed-PG), но docker-compose их требует, если
# postgres-* сервисы не отключены — оставь пустыми или подними compose
# только с backend+frontend (docker compose up backend frontend).
# Placeholder'ы вида `unused_in_preprod` ловятся сканером — поэтому пусто.
IMPORT_SERVICE_DB_USER=
IMPORT_SERVICE_DB_PASSWORD=
VISARY_DB_USER=
VISARY_DB_PASSWORD=

# ── 4. Bearer-токены и OIDC ──────────────────────────────────────
# На preprod включаем OIDC refresh-flow (см. doc 107):
VITE_VISARY_API_TOKEN=
Visary__BearerToken=
Visary__Auth__TokenEndpoint=https://id-pre-isup-alfa.k8s.npc.ba/connect/token
Visary__Auth__ClientId=visary-ui
# Капчурится один раз через UI Visary (offline_access scope) и хранится в Vault.
# В .env допускается только для preprod-смоук-теста, в проде — Vault.
VISARY_AUTH_REFRESH_TOKEN=__FILL_FROM_VAULT__

# ── 5. JWT-валидация входящих запросов ───────────────────────────
Auth__Authority=https://id-pre-isup-alfa.k8s.npc.ba
Auth__Audience=kilo-import-api
Auth__RequireHttpsMetadata=true

# ── 6. Build-time (для пересборки образов в корп. контуре, см. doc 129) ──
# Раскомментировать и подставить реальные корп-зеркала. Без них docker compose
# build пойдёт на публичные хосты, которые из контура недоступны.
# DOTNET_SDK_IMAGE=corp.registry.alfa/mcr/dotnet/sdk:10.0-preview-alpine
# DOTNET_ASPNET_IMAGE=corp.registry.alfa/mcr/dotnet/aspnet:10.0-preview-alpine
# NODE_IMAGE=corp.registry.alfa/library/node:20-alpine
# POSTGRES_IMAGE=corp.registry.alfa/library/postgres:16-alpine
# NUGET_FEED_URL=https://nuget.corp.alfa/repository/nuget-proxy/index.json
# NPM_REGISTRY_URL=https://npm.corp.alfa/repository/npm-proxy/
# ALPINE_MIRROR=alpine.mirror.corp.alfa
