# ══════════════════════════════════════════════════════════════════
# Окружение для KiloImportService — PROD
# Скопировать в `.env` (НЕ коммитить):
#     cp .env.prod.example .env
# ══════════════════════════════════════════════════════════════════
# Это шаблон. Реальные значения — из Vault / банковской secret-management.
# Имена секций — эталон service-dev (см. doc 132 / doc 145).
#
# ⚠️ Для prod-деплоя docker-compose — НЕ канонический путь. Скорее всего
#    используется k8s и helm values (см. alfa-building-fm-import.yaml).
#    Этот файл фиксирует, какие env-переменные приложение ожидает на проде.

# ── 1. Хосты внешних систем ──────────────────────────────────────
VISARY_BASE_URL=https://isup-alfa.k8s.npc.ba
VISARY_AUTH_BASE_URL=

# ── 2. Хост UI ───────────────────────────────────────────────────
UI_PUBLIC_URL=https://import.alfa.bank

# ── 3. БД (managed-PG, одна БД) ──────────────────────────────────
# Connection string берётся из Vault.
ConnectionStrings__AbFmImport=__FROM_VAULT__
ABFMI_DB_USER=
ABFMI_DB_USER_PASSWORD=

# ── 4. Bearer-токены и OIDC ──────────────────────────────────────
# В prod НЕ используем frontend-Bearer (VITE_*), все запросы идут через
# backend OIDC refresh-flow + JWT-аутентификацию входящих:
VITE_VISARY_API_TOKEN=
EndpointsConfiguration__VisaryApi__BearerToken=
EndpointsConfiguration__VisaryAuthApi__TokenEndpoint=https://id-isup-alfa.k8s.npc.ba/connect/token
EndpointsConfiguration__VisaryAuthApi__ClientId=visary-ui
# В prod заменить EnvironmentRefreshTokenStore на VaultRefreshTokenStore
# (см. Program.cs + doc 107). Здесь оставляем пусто — токен живёт в Vault.
VISARY_AUTH_REFRESH_TOKEN=

# ── 5. JWT-валидация входящих запросов ───────────────────────────
Features__Swagger=false
Features__RequireJwt=true
JwtConfiguration__Authority=https://id-isup-alfa.k8s.npc.ba
JwtConfiguration__Audience=kilo-import-api
JwtConfiguration__UseSsl=true

# ── 5a. Reverse-proxy base-path (см. doc 147) ────────────────────
# prod: сервис опубликован под /api/ab-fm-import + /api/ab-fm-import-web
Features__PathBase=/api/ab-fm-import
VITE_BASE_URL=/api/ab-fm-import-web/
VITE_API_PREFIX=/api/ab-fm-import

# ── 6. Окружение ASP.NET ─────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production

# ── 7. Build-time (для пересборки образов в корп. контуре, см. doc 129) ──
# DOTNET_SDK_IMAGE=corp.registry.alfa/mcr/dotnet/sdk:10.0-alpine
# DOTNET_ASPNET_IMAGE=corp.registry.alfa/mcr/dotnet/aspnet:10.0-alpine
# NODE_IMAGE=corp.registry.alfa/library/node:20-alpine
# POSTGRES_IMAGE=corp.registry.alfa/library/postgres:16-alpine
# NUGET_FEED_URL=https://nuget.corp.alfa/repository/nuget-proxy/index.json
# NPM_REGISTRY_URL=https://npm.corp.alfa/repository/npm-proxy/
# ALPINE_MIRROR=alpine.mirror.corp.alfa
# ALPINE_REPOSITORIES_URL=https://binary.alfabank.ru/artifactory/alpine-mirror/latest-stable
# ALPINE_OPENSSL_EDGE_FALLBACK=false
# ALPINE_EDGE_REPO_URL=https://dl-cdn.alpinelinux.org/alpine/edge/main
