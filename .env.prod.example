# ══════════════════════════════════════════════════════════════════
# Окружение для KiloImportService — PROD
# Скопировать в `.env` (НЕ коммитить):
#     cp .env.prod.example .env
# ══════════════════════════════════════════════════════════════════
# Это шаблон. Реальные значения — из Vault / банковской secret-management
# системы. См. doc_project/122-environment-config.md.
#
# ⚠️ Для prod-деплоя docker-compose в репозитории — НЕ канонический
#    путь. Скорее всего используется k8s/собственный deployment-pipeline.
#    Этот файл фиксирует, какие env-переменные приложение ожидает на проде.

# ── 1. Хосты внешних систем ──────────────────────────────────────
VISARY_BASE_URL=https://isup-alfa.k8s.npc.ba
VISARY_AUTH_BASE_URL=

# ── 2. Хост UI ───────────────────────────────────────────────────
UI_PUBLIC_URL=https://import.alfa.bank

# ── 3. БД (managed-PostgreSQL) ───────────────────────────────────
# Connection strings берутся из Vault.
ConnectionStrings__ServiceDb=__FROM_VAULT__
ConnectionStrings__VisaryDb=__FROM_VAULT__
# Не используются на prod (managed-PostgreSQL через ConnectionStrings__* выше).
# Значения оставлены пустыми — заполняются ТОЛЬКО если кто-то поднимает
# postgres-сервисы локально через `docker compose up postgres-*`.
# В k8s-деплое сервисов postgres-* нет.
# См. doc_project/121-security-fixes-appsec-v1.md § AppSec v3 — placeholder'ы
# вида `unused_in_prod` ловятся сканером как «потенциальный секрет», поэтому
# здесь пусто.
IMPORT_SERVICE_DB_USER=
IMPORT_SERVICE_DB_PASSWORD=
VISARY_DB_USER=
VISARY_DB_PASSWORD=

# ── 4. Bearer-токены и OIDC ──────────────────────────────────────
# В prod НЕ используем frontend-Bearer (VITE_*), все запросы идут через
# backend OIDC refresh-flow + JWT-аутентификацию входящих:
VITE_VISARY_API_TOKEN=
Visary__BearerToken=
Visary__Auth__TokenEndpoint=https://id-isup-alfa.k8s.npc.ba/connect/token
Visary__Auth__ClientId=visary-ui
# В prod заменить EnvironmentRefreshTokenStore на VaultRefreshTokenStore
# (см. Program.cs + doc 107). Здесь оставляем пусто — токен живёт в Vault.
VISARY_AUTH_REFRESH_TOKEN=

# ── 5. JWT-валидация входящих запросов ───────────────────────────
Auth__Authority=https://id-isup-alfa.k8s.npc.ba
Auth__Audience=kilo-import-api
Auth__RequireHttpsMetadata=true

# ── 6. Окружение ASP.NET ─────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production

# ── 7. Build-time (для пересборки образов в корп. контуре, см. doc 129) ──
# На prod docker-compose build обычно НЕ используется (k8s/CI собирает образы),
# но если нужно — задать корп-зеркала, иначе билд пойдёт на mcr/docker.io/nuget.org/npmjs.org.
# DOTNET_SDK_IMAGE=corp.registry.alfa/mcr/dotnet/sdk:10.0-preview-alpine
# DOTNET_ASPNET_IMAGE=corp.registry.alfa/mcr/dotnet/aspnet:10.0-preview-alpine
# NODE_IMAGE=corp.registry.alfa/library/node:20-alpine
# POSTGRES_IMAGE=corp.registry.alfa/library/postgres:16-alpine
# NUGET_FEED_URL=https://nuget.corp.alfa/repository/nuget-proxy/index.json
# NPM_REGISTRY_URL=https://npm.corp.alfa/repository/npm-proxy/
# ALPINE_MIRROR=alpine.mirror.corp.alfa
