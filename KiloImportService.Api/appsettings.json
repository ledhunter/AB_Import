{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ServiceDb": "Host=localhost;Port=5433;Database=import_service_db;Username=import_service;Password=import_service_pwd",
    "VisaryDb": "Host=localhost;Port=5434;Database=visary_webapi_db;Username=visary;Password=visary_pwd"
  },
  "ImportStorage": {
    "Path": "./.local-storage"
  },
  "Visary": {
    "BaseUrl": "https://isup-alfa-test.k8s.npc.ba",
    "BearerToken": "",
    "SyncPageSize": 200,
    "DefaultPageSize": 50,
    "LargePageSize": 500,
    "RequestTimeout": "00:00:30",
    "Auth": {
      "// summary":         "Если TokenEndpoint пуст — используется static-token из BearerToken (legacy/dev). См. doc_project/107.",
      "TokenEndpoint":      "",
      "ClientId":           "visary-ui",
      "GrantType":          "refresh_token",
      "Scope":              "",
      "ClientSecret":       "",
      "RefreshSkewSeconds": 60,
      "FallbackLifetimeSeconds": 300,
      "ExtraTokenRequestParameters": {}
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Auth": {
    "// summary":            "JWT-валидация ВХОДЯЩИХ запросов. Authority пуст = аутентификация ОТКЛЮЧЕНА (legacy/dev). На prod заполнить. См. doc_project/111-incoming-jwt-auth.md.",
    "Authority":             "",
    "Audience":              "kilo-import-api",
    "RequireHttpsMetadata":  true
  }
}
