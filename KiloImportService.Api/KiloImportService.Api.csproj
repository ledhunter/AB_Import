<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KiloImportService.Api</RootNamespace>
    <AssemblyName>KiloImportService.Api</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core ─ Swagger / OpenAPI / SignalR -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
    <!-- ⚠️ Версии 7.x несовместимы с .NET 10 / Microsoft.OpenApi 2.0 (OperationType удалён).
         См. doc_project/19-net10-swashbuckle.md. Пин строго на 10.1.7+. -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="10.1.7" />

    <!-- JWT bearer-аутентификация ВХОДЯЩИХ запросов.
         Включается через секцию Auth:Authority в appsettings/.env (см. doc_project/111). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.7" />

    <!-- EF Core 9 + Npgsql (поддерживает .NET 10 на runtime) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />

    <!-- Парсеры файлов -->
    <PackageReference Include="ClosedXML" Version="0.104.2" />              <!-- XLSX -->
    <PackageReference Include="ExcelDataReader" Version="3.7.0" />          <!-- XLS / XLSB -->
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.7.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.4" />  <!-- CP1251 для XLS -->
    <PackageReference Include="CsvHelper" Version="33.0.1" />               <!-- CSV -->

    <!-- Логирование / observability -->
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />

    <!-- PDF-экспорт отчётов по сессиям импорта (MIT-license, без нативных зависимостей).
         Шрифт регистрируется через PdfFontResolver — см. Pdf/PdfFontResolver.cs.
         ⚠️ package id с дефисом: `PDFsharp-MigraDoc`, не точкой. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Visary.Api.Client\Visary.Api.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Тесты обращаются к internal-хелперам мапперов (например,
         ExtractFirstRunOfDigits в RoomsFormImportMapper). -->
    <InternalsVisibleTo Include="KiloImportService.Api.Tests" />
  </ItemGroup>

  <!-- Эталонный XLSX-шаблон для экспорта бюджета («Бюджет_А4.1»).
       Visary при импорте бюджета чувствителен к структуре файла (порядок и состав строк
       строго как в эталоне), поэтому копируем эталон и подменяем только суммы — стили,
       header, примечания (G), ширины колонок и формулы сохраняются автоматически.
       См. doc_project/78-budget-xlsx-export.md. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\budget-template-a41.xlsx" />
  </ItemGroup>

</Project>
